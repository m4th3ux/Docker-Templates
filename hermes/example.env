# =============================================
# HERMES AGENT — variáveis de ambiente
# Uso:  cp example.env .env  e preencha as chaves
# =============================================

# --- Permissões do volume (opcional) ---
# UID/GID do usuário do host que deve ser dono dos arquivos em hermes_data.
# Deixe como está se não souber (o container remapeia o usuário interno).
HERMES_UID=10000
HERMES_GID=10000

# --- Fuso horário ---
TZ=America/Sao_Paulo

# =============================================
# PROVEDOR DE LLM (preencha APENAS o que for usar)
# =============================================
# OpenRouter — uma única chave para dezenas de modelos (recomendado p/ começar)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# =============================================
# TELEGRAM
# =============================================
# 1. Crie o bot com @BotFather: /newbot
# 2. Cole o token abaixo
TELEGRAM_BOT_TOKEN=

# Seus IDs de usuário do Telegram (separados por vírgula).
# Descubra o seu enviando /start para @userinfobot
TELEGRAM_ALLOWED_USERS=

# Canal/grupo padrão para entregas do cron (opcional)
TELEGRAM_HOME_CHANNEL=

# =============================================
# DISCORD
# =============================================
# 1. https://discord.com/developers/applications → New Application → Bot
# 2. Ative "Message Content Intent" (Settings → Bot)
# 3. Reset Token e cole abaixo
DISCORD_BOT_TOKEN=

# Seus IDs de usuário do Discord (separados por vírgula).
# Ative Developer Mode → clique direito no seu usuário → Copy User ID
DISCORD_ALLOWED_USERS=

# Canal padrão para entregas do cron (opcional)
DISCORD_HOME_CHANNEL=
