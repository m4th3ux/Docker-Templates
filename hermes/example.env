# =============================================
# HERMES AGENT — variáveis de ambiente
# Uso:  cp example.env .env  e preencha as chaves
# =============================================

# --- Permissões do volume (opcional) ---
# UID/GID do usuário do host que deve ser dono dos arquivos em hermes_data.
# Deixe como está se não souber (o container remapeia o usuário interno).
HERMES_UID=10000
HERMES_GID=10000

# --- Fuso horário ---
TZ=America/Sao_Paulo

# =============================================
# PROVEDOR DE LLM (preencha APENAS o que for usar)
# =============================================
# OpenRouter — uma única chave para dezenas de modelos (recomendado p/ começar)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google (Gemini) — https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# =============================================
# TELEGRAM
# =============================================
# 1. Crie o bot com @BotFather: /newbot
# 2. Cole o token abaixo
TELEGRAM_BOT_TOKEN=

# Seus IDs de usuário do Telegram (separados por vírgula).
# Descubra o seu enviando /start para @userinfobot
TELEGRAM_ALLOWED_USERS=

# Canal/grupo padrão para entregas do cron (opcional)
TELEGRAM_HOME_CHANNEL=

# =============================================
# DISCORD
# =============================================
# 1. https://discord.com/developers/applications → New Application → Bot
# 2. Ative "Message Content Intent" (Settings → Bot)
# 3. Reset Token e cole abaixo
DISCORD_BOT_TOKEN=

# Seus IDs de usuário do Discord (separados por vírgula).
# Ative Developer Mode → clique direito no seu usuário → Copy User ID
DISCORD_ALLOWED_USERS=

# Canal padrão para entregas do cron (opcional)
DISCORD_HOME_CHANNEL=

# =============================================
# OPCIONAL — Backend de terminal no HOST via SSH
# =============================================
# Faz o agente executar comandos no host do homelab (não dentro do container).
# Antes, gere a chave e libere no host:
#   ssh-keygen -t ed25519 -f id_ed25519 -N ""
#   cat id_ed25519.pub >> ~/.ssh/authorized_keys   # no host
#   cp id_ed25519 para dentro do volume hermes_data (pasta .ssh, chmod 600)
TERMINAL_ENV=ssh
TERMINAL_SSH_KEY=~/.ssh/id_ed25519
# HOST/PORT/USER/SENHA(SUDO) vêm do Infisical via fetch-secrets.sh
# (veja fetch-secrets.sh.example) — não coloque senha aqui.

# =============================================
# OPCIONAL — Identidade Infisical (fetch-secrets.sh)
# =============================================
# Machine identity (Universal Auth) com acesso aos segredos do projeto.
# As SENHAS ficam só no Infisical; aqui vai apenas a identidade.
# INFISICAL_DOMAIN=https://seu-infisical
# INFISICAL_CLIENT_ID=
# INFISICAL_CLIENT_SECRET=
# INFISICAL_PROJECT_ID=
# INFISICAL_ENVIRONMENT=dev
