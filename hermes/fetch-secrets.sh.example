#!/usr/bin/env bash
# ============================================================
# Hermes Agent — fetch de segredos do Infisical (cont-init)
# EXEMPLO para o template: ajuste o SECRETS_MAP do python para
# os nomes/caminhos do seu projeto Infisical.
#
# Roda no boot do container (s6-overlay cont-init) ANTES do gateway.
# As credenciais da identidade chegam via env (compose). Os valores
# são gravados em /opt/data/.env — nada de senha hardcoded.
#
# Uso no docker-compose.yml:
#   volumes:
#     - ./fetch-secrets.sh:/etc/cont-init.d/05-fetch-secrets.sh:ro,Z
#     - ./infisical-ca.crt:/opt/hermes/ca/infisical-ca.crt:ro,Z
#   environment:
#     - INFISICAL_DOMAIN=https://seu-infisical
#     - INFISICAL_CLIENT_ID=${INFISICAL_CLIENT_ID}
#     - INFISICAL_CLIENT_SECRET=${INFISICAL_CLIENT_SECRET}
#     - INFISICAL_PROJECT_ID=${INFISICAL_PROJECT_ID}
#     - INFISICAL_ENVIRONMENT=dev
#     - INFISICAL_CA_FILE=/opt/hermes/ca/infisical-ca.crt
# ============================================================
set -e

ENV_FILE="${HERMES_DATA_ENV_FILE:-/opt/data/.env}"
HERMES_UID="${HERMES_UID:-1000}"
HERMES_GID="${HERMES_GID:-1000}"

# s6-overlay v3 roda cont-init com ambiente limpo; o env do container fica
# em /run/s6/container_environment — restaura aqui antes de usar.
if [ -d /run/s6/container_environment ]; then
    for _f in /run/s6/container_environment/*; do
        [ -f "$_f" ] || continue
        _name=$(basename "$_f")
        if [ -z "${!_name:-}" ]; then
            _value=$(cat "$_f")
            export "${_name}=${_value}"
        fi
    done
fi

if [ -z "${INFISICAL_CLIENT_ID:-}" ] || [ -z "${INFISICAL_CLIENT_SECRET:-}" ]; then
    echo "fetch-secrets: identidade Infisical ausente — pulando" >&2
    exit 0
fi

/opt/hermes/.venv/bin/python3 - "$ENV_FILE" <<'PYEOF'
import base64
import json
import os
import ssl
import sys
import urllib.parse
import urllib.request

ENV_FILE = sys.argv[1]

DOMAIN = os.environ["INFISICAL_DOMAIN"].rstrip("/")
CLIENT_ID = os.environ["INFISICAL_CLIENT_ID"]
CLIENT_SECRET = os.environ["INFISICAL_CLIENT_SECRET"]
PROJECT_ID = os.environ["INFISICAL_PROJECT_ID"]
ENVIRONMENT = os.environ.get("INFISICAL_ENVIRONMENT", "dev")
CA_FILE = os.environ.get("INFISICAL_CA_FILE", "/opt/hermes/ca/infisical-ca.crt")

ctx = ssl.create_default_context(cafile=CA_FILE)


def request(method, path, body=None, token=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(DOMAIN + path, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", "Bearer " + token)
    with urllib.request.urlopen(req, context=ctx, timeout=20) as resp:
        return json.loads(resp.read().decode() or "{}")


def access_token():
    data = request(
        "POST",
        "/api/v1/auth/universal-auth/login",
        {"clientId": CLIENT_ID, "clientSecret": CLIENT_SECRET},
    )
    return data["accessToken"]


TOKEN = access_token()


def secret(name, path):
    # include_imports=true: resolve segredos importados de outros projetos
    query = urllib.parse.urlencode(
        {
            "projectId": PROJECT_ID,
            "environment": ENVIRONMENT,
            "secretPath": path,
            "include_imports": "true",
        }
    )
    data = request(
        "GET", f"/api/v4/secrets/{urllib.parse.quote(name)}?{query}", token=TOKEN
    )
    return data["secret"]["secretValue"]


def basic(user, password):
    raw = f"{user}:{password}".encode()
    return "Basic " + base64.b64encode(raw).decode()


# ---- Ajuste este mapa para os nomes/caminhos do SEU Infisical ----
SECRETS = {
    # "SUDO_PASSWORD": ("LAB_SSH_PASSWORD", "/ssh"),
    # "TERMINAL_SSH_HOST": ("LAB_SSH_HOST", "/ssh"),
    # "TERMINAL_SSH_PORT": ("LAB_SSH_PORT", "/ssh"),
    # "TERMINAL_SSH_USER": ("LAB_SSH_USER", "/ssh"),
    # "OBSIDIAN_MCP_URL": ("OBSIDIAN_MCP_URL", "/obsidian"),
    # "WORDPRESS_MCP_URL": ("WORDPRESS_MCP_URL", "/wordpress"),
}

BASIC_AUTH_HEADERS = {
    # "OBSIDIAN_MCP_AUTH_HEADER": (("OBSIDIAN_MCP_BASIC_USER", "/obsidian"),
    #                              ("OBSIDIAN_MCP_BASIC_PASSWORD", "/obsidian")),
}

updates = {}
for env_name, (secret_name, path) in SECRETS.items():
    updates[env_name] = secret(secret_name, path)
for env_name, (user_ref, pass_ref) in BASIC_AUTH_HEADERS.items():
    user = secret(*user_ref)
    password = secret(*pass_ref)
    updates[env_name] = basic(user, password)

# ---- Upsert em /opt/data/.env preservando o restante ----
lines = []
if os.path.exists(ENV_FILE):
    with open(ENV_FILE) as fh:
        for line in fh.read().splitlines():
            key = line.split("=", 1)[0].strip()
            if key in updates:
                lines.append(f"{key}={updates.pop(key)}")
            else:
                lines.append(line)
for key, value in updates.items():
    lines.append(f"{key}={value}")

with open(ENV_FILE, "w") as fh:
    fh.write("\n".join(lines) + "\n")
os.chmod(ENV_FILE, 0o600)
print("fetch-secrets: segredos atualizados em " + ENV_FILE)
PYEOF

chown "${HERMES_UID}:${HERMES_GID}" "$ENV_FILE" 2>/dev/null || true
echo "fetch-secrets: concluído"
