# Copie para .env e preencha. NUNCA commite o .env.

# URL base do site WordPress (sem /wp-json).
WORDPRESS_API_URL=https://meusite.com.br

# Usuário e Application Password do WordPress.
# Gere em: Usuários -> Perfil -> Application Passwords.
WORDPRESS_USERNAME=mcp
WORDPRESS_PASSWORD=

# Porta publicada na LAN.
MCP_WORDPRESS_PORT=8081

# O hash bcrypt do Basic auth fica no Caddyfile (não aqui), porque o
# Docker Compose interpola "$" dentro do .env e corromperia o hash.
