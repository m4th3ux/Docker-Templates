# Copie para .env e preencha. NUNCA commite o .env.

# Caminho ABSOLUTO do vault no host (precisa conter .obsidian/).
OBSIDIAN_VAULT_PATH=/home/usuario/notes/Main Notes

# Identificador do vault exposto às ferramentas MCP.
OBSIDIAN_VAULT_ID=notes

# Porta publicada na LAN.
MCP_OBSIDIAN_PORT=8083

# Dono dos arquivos gravados no vault (id -u / id -g).
PUID=1000
PGID=1000

# O hash bcrypt do Basic auth fica no Caddyfile (não aqui), porque o
# Docker Compose interpola "$" dentro do .env e corromperia o hash.
